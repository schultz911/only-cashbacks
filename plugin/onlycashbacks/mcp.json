{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "onlycashbacks": {
      "type": "streamable-http",
      "url": "https://only-cashbacks.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "wallet"
            ],
            "defaultScopes": [
              "wallet"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
