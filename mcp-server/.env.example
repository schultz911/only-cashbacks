# OnlyCashbacks MCP Server - Environment Variables
# Copy this file to .env and fill in the values

# Firebase Admin SDK authentication (choose one):
# Option 1: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option 2: Inline service account JSON (for Railway/Docker)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Firestore database ID (defaults to the OnlyCashbacks production database)
# FIREBASE_DATABASE_ID=ai-studio-onlycashbacks-9dfa3f2d-5762-4049-a6c8-583bd3c24948

# Transport mode: "stdio" for local, "streamable-http" (or legacy "sse") for remote hosting
# MCP_TRANSPORT=stdio

# Remote port (default: 3001); both /mcp and legacy /sse are available
# PORT=3001
