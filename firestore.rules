rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Crashlytics style client error logging
    match /clientErrors/{errorId} {
      function validReport() {
        let data = request.resource.data;
        return request.auth != null && errorId == request.auth.uid &&
          data.keys().hasOnly(['userId', 'error', 'stack', 'componentStack', 'timestamp', 'url', 'userAgent']) &&
          data.userId == request.auth.uid &&
          data.error is string && data.error.size() <= 1024 &&
          data.stack is string && data.stack.size() <= 4096 &&
          data.componentStack is string && data.componentStack.size() <= 4096 &&
          data.url is string && data.url.size() <= 512 &&
          data.userAgent is string && data.userAgent.size() <= 512 &&
          data.timestamp == request.time;
      }
      allow create: if validReport();
      allow update: if validReport() &&
        request.time >= resource.data.timestamp + duration.value(1, 'm');
      allow read, delete: if false;
    }
  }
}
